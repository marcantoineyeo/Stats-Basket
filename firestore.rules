rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chaque équipe vit sous /teams/{code} : il faut connaître le code pour lire ou écrire.
    // meta = équipe, games = matchs, sessions = séances d'entraînement, drills = exercices perso
    match /teams/{team}/{coll}/{doc} {
      allow read, write: if request.auth != null && team.size() >= 8
                         && coll in ['meta', 'games', 'sessions', 'drills'];
    }
  }
}
