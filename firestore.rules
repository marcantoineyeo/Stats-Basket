rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chaque équipe vit sous /teams/{code} : il faut connaître le code pour lire ou écrire.
    // La liste des équipes n'est jamais lisible, donc impossible de découvrir les codes.
    match /teams/{team}/meta/{doc} {
      allow read, write: if request.auth != null && team.size() >= 8;
    }
    match /teams/{team}/games/{game} {
      allow read, write: if request.auth != null && team.size() >= 8;
    }
  }
}
